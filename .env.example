# Three Cent Contacts — API keys
# Copy this into your ~/.env and fill in real values.

# =============================================================================
# REQUIRED
# =============================================================================

# OpenRouter — runs Perplexity Sonar (stage 1, AI web search) and Gemini Flash
# (stage 7 SERP parsing).
# Sign up at https://openrouter.ai → API Keys → create a key. Starts with sk-or-v1-.
# Cost: ~$0.005 per stage 1 search; ~$0.001 per stage 7 parse.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Bouncer (formerly UseBouncer) — SMTP verification at stage 6.
# Sign up at https://usebouncer.com → API Access → create a key.
# Cost: ~$0.01 per verification. Trial credits on signup.
BOUNCER_API_KEY=your-bouncer-key-here

# =============================================================================
# OPTIONAL — the waterfall works without these, but with thinner coverage.
# =============================================================================

# Hunter.io — domain email pattern lookup at stage 4. Only fires when stages
# 1-3 produce names but no example email at the domain.
# Sign up at https://hunter.io → API → copy your key.
# Free tier: 25 lookups/month. Paid: ~$0.01 per lookup.
HUNTER_API_KEY=your-hunter-key-here

# Bright Data SERP API — Google scrape fallback at stage 7 for the hardest
# targets that stages 1-6 couldn't resolve. Uses HTTP proxy credentials,
# NOT a single API key.
# Setup: https://brightdata.com → create a "SERP API" zone → copy the proxy
# username (looks like brd-customer-hl_XXXXX-zone-serp_api1) and password.
# Cost: ~$0.015-0.025 per row that reaches stage 7.
# If either var is blank, stage 7 silently skips.
BRIGHTDATA_SERP_USERNAME=
BRIGHTDATA_SERP_PASSWORD=
